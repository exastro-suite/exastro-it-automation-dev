# Global values
# not quate strings
@sys-user-id = admin
@sys-user-pw = password
@org-user-id = test_user
@org-user-pw = passsword

@base_sys_url = http://platform-auth:{{sys-mng-port}}
@base_org_url = http://platform-auth:{{org-mng-port}}

@organization_id = org1
@workspace_id = ws1

# Menu names
@conductor_menu = conductor_class_edit
@confirmation_menu = conductor_confirmation
@history_menu = conductor_list

# Test data (set these after executing create/execute operations)
@conductor_class_id = auto-increment-id-of-conductor
@conductor_instance_id = auto-increment-id-of-conductor-instance

