###
# Conductor: Conductorインスタンス詳細情報を取得する (get-conductor-instance)
# Get detailed Conductor instance information
GET {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/ita/menu/{{confirmation_menu}}/conductor/{{conductor_instance_id}}/
Authorization: Basic {{org-user-id}} {{org-user-pw}}

###
# Conductor: Conductor作業の投入データを取得する (get-conductor-input-data)
# Get Conductor execution input data
GET {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/ita/menu/{{history_menu}}/conductor/{{conductor_instance_id}}/input_data/
Authorization: Basic {{org-user-id}} {{org-user-pw}}

###
# Conductor: Conductor作業の投入データを取得する（バイナリ形式） (get-conductor-input-data)
# Get Conductor execution input data (binary format)
GET {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/ita/menu/{{history_menu}}/conductor/{{conductor_instance_id}}/input_data/?file=binary
Authorization: Basic {{org-user-id}} {{org-user-pw}}

###
# Conductor: Conductor作業の結果データを取得する (get-conductor-result-data)
# Get Conductor execution result data
GET {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/ita/menu/{{history_menu}}/conductor/{{conductor_instance_id}}/result_data/
Authorization: Basic {{org-user-id}} {{org-user-pw}}

###
# Conductor: Conductor作業の結果データを取得する（バイナリ形式） (get-conductor-result-data)
# Get Conductor execution result data (binary format)
GET {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/ita/menu/{{history_menu}}/conductor/{{conductor_instance_id}}/result_data/?file=binary
Authorization: Basic {{org-user-id}} {{org-user-pw}}
